# Store text files with LF line endings in the repo, so scripts such as
# mvnw run correctly on Linux CI runners even though I develop on Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.gif binary
*.jar binary
